[Unit]
Description=Studica fixed firewall and network guard
PartOf=studica-robot.target
After=NetworkManager.service ufw.service
Before=studica-web.service
Wants=NetworkManager.service ufw.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/studica/current/install/lib/studica_vmxpi_ros2/studica_network_guard
RemainAfterExit=yes
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=studica-robot.target
