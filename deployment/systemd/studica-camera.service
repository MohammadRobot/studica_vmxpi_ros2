[Unit]
Description=Studica on-demand depth camera runtime
PartOf=studica-robot.target
After=studica-hardware.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=studica
Group=studica
SupplementaryGroups=video
EnvironmentFile=-/etc/studica/robot.env
ExecStart=/opt/studica/current/install/lib/studica_vmxpi_ros2/studica_sensor_runtime camera
Restart=on-failure
RestartSec=4
TimeoutStartSec=40
TimeoutStopSec=8
KillSignal=SIGINT
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/dev
CPUQuota=120%
MemoryMax=700M
UMask=0027
SyslogIdentifier=studica-camera
