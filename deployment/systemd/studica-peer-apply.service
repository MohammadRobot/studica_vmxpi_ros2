[Unit]
Description=Apply a newly paired Studica companion peer
After=studica-robot.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/systemctl restart studica-robot.target
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
RestrictSUIDSGID=yes
LockPersonality=yes
