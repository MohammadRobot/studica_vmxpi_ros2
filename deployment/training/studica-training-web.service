[Unit]
Description=Studica authenticated sensor observation HTTPS (no motor control)
After=network.target
Conflicts=studica-web.service studica-hardware.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=studica
Group=studica
Environment=ROS_DOMAIN_ID=78
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=ROS_LOCALHOST_ONLY=0
Environment=CYCLONEDDS_URI=file:///opt/studica/training-20260907/cyclonedds.xml
Environment=ROS_LOG_DIR=/var/log/studica-training-web
ExecStart=/bin/bash /opt/studica/training-20260907/studica_observer_web_runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
KillSignal=SIGINT
KillMode=control-group
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Cyclone DDS needs netlink to enumerate even the loopback interface.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
LogsDirectory=studica-training-web
LogsDirectoryMode=0750
RuntimeDirectory=studica-training-web
RuntimeDirectoryMode=0700
CPUQuota=100%
MemoryMax=384M
TasksMax=96
UMask=0077

[Install]
WantedBy=multi-user.target
