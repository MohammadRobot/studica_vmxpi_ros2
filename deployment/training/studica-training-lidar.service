[Unit]
Description=Studica stationary training X2 LiDAR (no motor runtime)
After=network.target dev-ttyUSB0.device
BindsTo=dev-ttyUSB0.device
JobTimeoutSec=30
StartLimitIntervalSec=120
StartLimitBurst=3
Conflicts=studica-lidar.service studica-hardware.service
ConditionPathExists=/dev/ydlidar

[Service]
Type=simple
User=vmx
Group=vmx
SupplementaryGroups=dialout
Environment=STUDICA_RELEASE_ROOT=/home/vmx/studica_ws
Environment=ROS_DOMAIN_ID=78
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=ROS_LOCALHOST_ONLY=0
Environment=CYCLONEDDS_URI=file:///opt/studica/training-20260907/cyclonedds.xml
Environment=ROS_LOG_DIR=/var/log/studica-training-lidar
ExecStart=/bin/bash /opt/studica/training-20260907/studica_sensor_runtime lidar
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
KillSignal=SIGINT
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/ttyUSB0 rw
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LogsDirectory=studica-training-lidar
LogsDirectoryMode=0750
CPUQuota=100%
MemoryMax=384M
TasksMax=96
UMask=0027

[Install]
WantedBy=multi-user.target
