<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <AllowMulticast>false</AllowMulticast>
      <Interfaces>
        <NetworkInterface name="lo" priority="10" multicast="false" />
        <NetworkInterface name="eth0" presence_required="false" multicast="false" />
        <NetworkInterface name="wlan0" presence_required="false" multicast="false" />
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>32</MaxAutoParticipantIndex>
      <Peers AddLocalhost="true">
        <!-- First boot adds the explicitly approved companion peer here. -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
